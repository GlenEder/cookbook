---
import { getCollection, render } from "astro:content";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import { buildBasePages, type RecipeInput } from "../lib/book-model.ts";
import { siteTitle } from "../data/site.ts";
import Book from "../components/Book/Book";
import "../styles/book.css";

// Recipes in stable doc order (alphabetical by slug within each section).
const entries = (await getCollection("recipes")).sort((a, b) => a.id.localeCompare(b.id));
const container = await AstroContainer.create();

const recipes: RecipeInput[] = [];
const recipeHtml: { slug: string; html: string }[] = [];
for (const entry of entries) {
	const { Content } = await render(entry);
	const html = await container.renderToString(Content);
	recipes.push({
		slug: entry.id,
		title: entry.data.title,
		section: entry.data.section,
		yield: entry.data.yield,
		inTesting: entry.data.inTesting,
		source: entry.data.source,
	});
	recipeHtml.push({ slug: entry.id, html });
}

// Single source of truth for the ordered page list (Stage 3 consumes it too).
const pages = buildBasePages(recipes);

// Build-time search index (Stage 3): recipe title + tag-stripped body text,
// embedded as JSON for the client-side search island. Title lives in `t`,
// ingredients + instructions text in `x`.
function toText(html: string): string {
	return html
		.replace(/<[^>]+>/g, " ")
		.replace(/&amp;/g, "&")
		.replace(/&lt;/g, "<")
		.replace(/&gt;/g, ">")
		.replace(/&quot;/g, '"')
		.replace(/&#0?39;/g, "'")
		.replace(/&nbsp;/g, " ")
		.replace(/\s+/g, " ")
		.trim();
}
const searchIndex = recipes.map((recipe, i) => ({
	slug: recipe.slug,
	t: recipe.title,
	x: toText(recipeHtml[i].html),
}));
// \u003c keeps any "</script>" sequence inside recipe text from breaking out.
const searchJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="preload" as="font" type="font/woff2" href="/fonts/eb-garamond-v33-latin-regular.woff2" crossorigin="anonymous" />
		<title>{siteTitle}</title>
	</head>
	<body>
		<script type="application/json" id="search-index" set:html={searchJson} />
		<div class="recipe-html-source" hidden>
			{recipeHtml.map((r) => <template data-recipe-html={r.slug} set:html={r.html} />)}
		</div>
		<Book client:only="react" pages={pages} />
	</body>
</html>
